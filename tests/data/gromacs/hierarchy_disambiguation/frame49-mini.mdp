integrator               = md
dt                       = 0.002
nsteps                   = 1
cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 0.8
coulombtype              = Cut-off
rcoulomb                 = 0.8
vdwtype                  = Cut-off
rvdw                     = 0.8
pbc                      = xyz
constraints              = none
continuation             = yes
gen-vel                  = no
nstlog                   = 1
nstenergy                = 1
nstxout-compressed       = 1
compressed-x-precision   = 1000
