{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
              "${file}"
            ],
        },
        {
            "name": "pytest",
            "type": "debugpy",
            "request": "launch",
            "program": "uv run pytest",
            "justMyCode": false,
            "env": {
                "_PYTEST_RAISE": "1"
            },
            "args": [
                "-sv",
                "tests"
            ]
        }
    ]
}